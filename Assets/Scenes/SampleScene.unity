  m_Text: "\u0411\u0430\u043B\u0430\u043D\u0441, \u0434\u043E\u0441\u0432\u0456\u0434
    \u0443\u0441\u0456\u0445 \u0441\u0442\u0440\u0430\u0432 \u0456 \u043F\u0440\u0438\u0434\u0431\u0430\u043D\u0456
    \u043F\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u043D\u044F \u0431\u0443\u0434\u0435
    \u0441\u043A\u0438\u043D\u0443\u0442\u043E.\n\u041F\u043E\u043F\u0435\u0440\u0435\u0434\u043D\u0456\u0439
    \u043F\u0440\u043E\u0433\u0440\u0435\u0441 \u0456 \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u0443
    \u043A\u043E\u043F\u0456\u044E \u0431\u0443\u0434\u0435 \u0437\u0430\u043C\u0456\u043D\u0435\u043D\u043E."
